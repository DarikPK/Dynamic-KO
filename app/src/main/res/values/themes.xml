<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.DynamicCollage" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Customize your theme here. -->
    </style>

    <!-- Theme for the splash screen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background to white -->
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <!-- Use a transparent icon to effectively hide it -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_transparent</item>
        <!-- Set the theme of the main app -->
        <item name="postSplashScreenTheme">@style/Theme.DynamicCollage</item>
    </style>
</resources>
